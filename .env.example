# Local SQLite file by default. In production: libsql://<db>-<org>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Admin login at /admin (12+ characters). Leave empty to disable admin.
ADMIN_PASSWORD=change-me-to-something-long
# 32+ random chars (required; the app refuses to start without it outside `next dev`); signs the admin cookie and salts device/IP hashes. `openssl rand -base64 32`
SESSION_SECRET=

# Origin used in printed QR codes, e.g. https://laundry.example.com (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000

# Optional Cloudflare Turnstile bot check on reports (both must be set to enable).
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional laundry helper chat (AI). Leave empty to hide it. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5-5 (claude-sonnet-5-5 costs about half).
ANTHROPIC_MODEL=
# Optional "notify me when it's fixed" push notifications (both keys must be set to enable).
# Generate once with: npx web-push generate-vapid-keys  (changing them later drops everyone's pending alerts)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or your https site. Defaults to PUBLIC_BASE_URL.
VAPID_SUBJECT=
