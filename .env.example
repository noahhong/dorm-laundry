# Local SQLite file by default. In production: libsql://<db>-<org>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Admin login at /admin. Leave empty to disable admin.
ADMIN_PASSWORD=change-me
# 32+ random chars; signs the admin cookie and salts device/IP hashes. `openssl rand -base64 32`
SESSION_SECRET=

# Origin used in printed QR codes, e.g. https://laundry.example.com (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000
